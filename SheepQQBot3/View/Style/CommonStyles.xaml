<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converter="clr-namespace:SheepQQBot3.Converter"
                    xmlns:local="clr-namespace:SheepQQBot3.View">
    <converter:SingleLineTextConverter x:Key="SingleLineTextConverter" />
    <Style x:Key="WindowBaseStyle" TargetType="Window">
        <Setter Property="FontFamily" Value="微软雅黑" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="WindowStyle" Value="ToolWindow" />
    </Style>
    <VisualBrush x:Key="HintText"
                 AlignmentX="Left"
                 Opacity="0.4"
                 Stretch="None"
                 TileMode="None">
        <VisualBrush.Visual>
            <TextBlock FontStyle="Italic" Text=" 请输入内容" />
        </VisualBrush.Visual>
    </VisualBrush>
    <Style x:Key="HintTextStyle" TargetType="TextBox">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="2,0,0,0" />
        <Style.Triggers>
            <Trigger Property="Text" Value="{x:Null}">
                <Setter Property="Background" Value="{StaticResource HintText}" />
            </Trigger>
            <Trigger Property="Text" Value="">
                <Setter Property="Background" Value="{StaticResource HintText}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="NoResizeHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="IsEnabled" Value="False" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="TextElement.Foreground" Value="Black" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="EditDeleteMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource FindAncestor, AncestorType=ContextMenu}}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <local:DebugDataBindingConverter x:Key="DebugBinding" />
</ResourceDictionary>