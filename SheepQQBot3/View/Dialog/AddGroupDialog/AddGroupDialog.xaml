<local:AddDialogWindowBase x:Class="SheepQQBot3.View.AddGroupDialog"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:local="clr-namespace:SheepQQBot3.View"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           Title="群配置"
                           Width="240"
                           Height="148"
                           x:TypeArguments="local:AddGroupDialogViewModel"
                           mc:Ignorable="d">
    <Window.DataContext>
        <local:AddGroupDialogViewModel />
    </Window.DataContext>
    <Grid Margin="4,4,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="24" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.Resources>
            <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Padding" Value="3,2,0,0" />
            </Style>
        </Grid.Resources>
        <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="号码：" />
        <TextBox x:Name="TxtGroupId"
                 Grid.Row="0"
                 Grid.Column="1"
                 Padding="3,0,0,0"
                 Style="{StaticResource HintTextStyle}"
                 Text="{Binding TargetId}" />
        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Style="{StaticResource HeaderTextBlockStyle}"
                   Text="类型：" />
        <ComboBox Grid.Row="1"
                  Grid.Column="1"
                  ItemsSource="{Binding GroupConfigs}"
                  SelectedItem="{Binding SelectedGroupConfig}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Style="{StaticResource HeaderTextBlockStyle}"
                   Text="名称：" />
        <TextBox Grid.Row="2"
                 Grid.Column="1"
                 Padding="3,0,0,0"
                 Style="{StaticResource HintTextStyle}"
                 Text="{Binding TargetName}" />
        <Grid Grid.Row="3"
              Grid.Column="0"
              Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Click="OK_Click"
                    Content="确定"
                    Style="{StaticResource DialogButtonStyle}" />
            <Button Grid.Column="1"
                    Click="Cancel_Click"
                    Content="取消"
                    Style="{StaticResource DialogButtonStyle}" />
        </Grid>
    </Grid>
</local:AddDialogWindowBase>
