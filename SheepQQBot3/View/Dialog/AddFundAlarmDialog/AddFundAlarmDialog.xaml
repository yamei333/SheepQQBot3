<local:AddDialogWindowBase x:Class="SheepQQBot3.View.AddFundAlarmDialog"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:local="clr-namespace:SheepQQBot3.View"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           Title="基金播报配置"
                           Width="240"
                           Height="124"
                           x:TypeArguments="local:AddFundAlarmDialogViewModel"
                           mc:Ignorable="d">
    <Window.DataContext>
        <local:AddFundAlarmDialogViewModel />
    </Window.DataContext>
    <Grid Margin="4,4,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.Resources>
            <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Padding" Value="3,2,0,0" />
            </Style>
        </Grid.Resources>
        <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="编号：" />
        <TextBox x:Name="TxtFundId"
                 Grid.Row="0"
                 Grid.Column="1"
                 Style="{StaticResource HintTextStyle}"
                 Text="{Binding FundId}" />
        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Style="{StaticResource HeaderTextBlockStyle}"
                   Text="备注：" />
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Style="{StaticResource HintTextStyle}"
                 Text="{Binding FundRemark}" />
        <Grid Grid.Row="2"
              Grid.Column="0"
              Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Click="OK_Click"
                    Content="确定"
                    Style="{StaticResource DialogButtonStyle}" />
            <Button Grid.Column="1"
                    Click="Cancel_Click"
                    Content="取消"
                    Style="{StaticResource DialogButtonStyle}" />
        </Grid>
    </Grid>
</local:AddDialogWindowBase>
