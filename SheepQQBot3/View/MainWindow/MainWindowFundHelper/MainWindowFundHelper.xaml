<UserControl x:Class="SheepQQBot3.View.MainWindowFundHelper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SheepQQBot3.View"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="MainWindowFundHelper_OnLoaded"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <local:MainWindowFundHelperViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.Resources>
            <Style x:Key="AlarmAideTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="140" />
            <RowDefinition Height="220" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0">
            <GroupBox.Header>
                <TextBlock Text="基金播报时间设置" />
            </GroupBox.Header>
            <ListView x:Name="FundAlarmConfigList"
                      ItemsSource="{Binding SelectedSetConfig.FundAlarmConfigs.Values}"
                      MouseDoubleClick="FundAlarmConfigList_MouseDoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectedItem="{Binding SelectedFundAlarmConfig}">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="FundAlarmConfigList_OnAdd" Header="新增" />
                        <MenuItem Click="FundAlarmConfigList_OnEdit"
                                  Header="修改"
                                  Style="{StaticResource EditDeleteMenuItemStyle}" />
                        <MenuItem Click="FundAlarmConfigList_OnDelete"
                                  Header="删除"
                                  Style="{StaticResource EditDeleteMenuItemStyle}" />
                        <MenuItem Click="FundAlarmConfigList_OnTest" Header="测试发送" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource NoResizeHeaderStyle}">
                        <GridViewColumn Width="70" Header="名称">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource AlarmAideTextBlockStyle}" Text="{Binding AlarmName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="194" Header="时间条件">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource AlarmAideTextBlockStyle}"
                                               Text="{Binding Condition}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Condition}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="30"
                                        CellTemplate="{StaticResource CheckImageButtonTemplate}"
                                        Header="√" />
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
        <GroupBox Grid.Row="0" Grid.Column="1">
            <GroupBox.Header>
                <TextBlock Text="基金阈值观测时间设置" />
            </GroupBox.Header>
            <ListView x:Name="FundLimitObserveConfigList"
                      ItemsSource="{Binding SelectedSetConfig.FundLimitObserveConfigs.Values}"
                      MouseDoubleClick="FundLimitObserveConfigList_MouseDoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectedItem="{Binding SelectedFundLimitObserveConfig}">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="FundLimitObserveConfigList_OnAdd" Header="新增" />
                        <MenuItem Click="FundLimitObserveConfigList_OnEdit"
                                  Header="修改"
                                  Style="{StaticResource EditDeleteMenuItemStyle}" />
                        <MenuItem Click="FundLimitObserveConfigList_OnDelete"
                                  Header="删除"
                                  Style="{StaticResource EditDeleteMenuItemStyle}" />
                        <MenuItem Click="FundLimitObserveConfigList_OnTest" Header="测试发送" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource NoResizeHeaderStyle}">
                        <GridViewColumn Width="70" Header="名称">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource AlarmAideTextBlockStyle}" Text="{Binding LimitObserveName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="194" Header="时间条件">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource AlarmAideTextBlockStyle}"
                                               Text="{Binding Condition}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Condition}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="30"
                                        CellTemplate="{StaticResource CheckImageButtonTemplate}"
                                        Header="√" />
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
        <GroupBox Grid.Row="1" Grid.Column="0">
            <GroupBox.Header>
                <TextBlock Text="基金播报设置" />
            </GroupBox.Header>
            <ListView x:Name="AlarmFundConfigList"
                      ItemsSource="{Binding SelectedFundAlarmConfig.AlarmFundConfigs}"
                      MouseDoubleClick="AlarmFundConfigList_MouseDoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectedItem="{Binding SelectedAlarmFundConfig}">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="AlarmFundConfigList_OnAdd" Header="新增" />
                        <MenuItem Click="AlarmFundConfigList_OnEdit"
                                  Header="修改"
                                  Style="{StaticResource EditDeleteMenuItemStyle}" />
                        <MenuItem Click="AlarmFundConfigList_OnDelete"
                                  Header="删除"
                                  Style="{StaticResource EditDeleteMenuItemStyle}" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource NoResizeHeaderStyle}">
                        <GridViewColumn Width="88" Header="基金编号">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource AlarmAideTextBlockStyle}" Text="{Binding Value.FundId}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="158" Header="备注">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource AlarmAideTextBlockStyle}" Text="{Binding Value.FundRemark}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="30"
                                        CellTemplate="{StaticResource CheckImageButtonTemplate_Value}"
                                        Header="√" />
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
        <GroupBox Grid.Row="1" Grid.Column="1">
            <GroupBox.Header>
                <TextBlock Text="基金阈值观测设置" />
            </GroupBox.Header>
            <ListView x:Name="LimitObserveFundConfigList"
                      ItemsSource="{Binding SelectedFundLimitObserveConfig.LimitObserveFundConfigs}"
                      MouseDoubleClick="LimitObserveFundConfigList_MouseDoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectedItem="{Binding SelectedLimitObserveFundConfig}">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="LimitObserveFundConfigList_OnAdd" Header="新增" />
                        <MenuItem Click="LimitObserveFundConfigList_OnEdit"
                                  Header="修改"
                                  Style="{StaticResource EditDeleteMenuItemStyle}" />
                        <MenuItem Click="LimitObserveFundConfigList_OnDelete"
                                  Header="删除"
                                  Style="{StaticResource EditDeleteMenuItemStyle}" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource NoResizeHeaderStyle}">
                        <GridViewColumn Width="88" Header="基金编号">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource AlarmAideTextBlockStyle}" Text="{Binding Value.FundId}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="88" Header="阈值类型">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource AlarmAideTextBlockStyle}" Text="{Binding Value.FundObserveTypeString}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="68" Header="阈值">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource AlarmAideTextBlockStyle}" Text="{Binding Value.AlertLimitString}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="30"
                                        CellTemplate="{StaticResource CheckImageButtonTemplate_Value}"
                                        Header="√" />
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
    </Grid>
</UserControl>
