<UserControl x:Class="SheepQQBot3.View.MainWindowAlarmAideSubmit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SheepQQBot3.View"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="MainWindowAlarmAideSubmit_OnLoaded"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <local:MainWindowAlarmAideSubmitViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="300" />
        </Grid.RowDefinitions>
        <GroupBox>
            <GroupBox.Header>
                <TextBlock Text="闹钟助手投稿成员" />
            </GroupBox.Header>
            <ListBox x:Name="AlarmAideSubmitMemberList"
                     ItemsSource="{Binding SelectedSetConfig.AlarmAideSubmitMemberIds}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectedItem="{Binding SelectedMemberId}"
                     SelectionMode="Extended">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="AlarmAideSubmitMemberList_OnAdd" Header="新增" />
                        <MenuItem Click="AlarmAideSubmitMemberList_OnDelete"
                                  Header="删除"
                                  Style="{StaticResource EditDeleteMenuItemStyle}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </GroupBox>
    </Grid>
</UserControl>
