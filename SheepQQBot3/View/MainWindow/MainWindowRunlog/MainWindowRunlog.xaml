<UserControl x:Class="SheepQQBot3.View.MainWindowRunlog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SheepQQBot3.View"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="240"
             d:DesignWidth="680"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <local:MainWindowRunlogViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.Resources>
            <Style x:Key="AlarmAideTextBlockStyle" TargetType="TextBlock" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="680" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListView Grid.Column="0"
                  ContextMenuOpening="RunLog_OnContextMenuOpening"
                  ItemsSource="{Binding RunLogs}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectedItem="{Binding SelectedRunLog}">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="RunLog_OnRepeat" Header="复读这条消息">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource FindAncestor, AncestorType=ContextMenu}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedRunLog.IsGroupMessage}" Value="false">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource NoResizeHeaderStyle}">
                    <GridViewColumn Width="60" Header="时间">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource AlarmAideTextBlockStyle}" Text="{Binding DateTimeStr}" />
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="62" Header="类型">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource AlarmAideTextBlockStyle}" Text="{Binding MessageTypeStr}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="86" Header="来源">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Style="{StaticResource AlarmAideTextBlockStyle}"
                                               Text="{Binding GroupId}"
                                               Visibility="{Binding HasGroupId, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Style="{StaticResource AlarmAideTextBlockStyle}" Text="{Binding SenderId}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="438" Header="内容">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ContentTitle}">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource AlarmAideTextBlockStyle}" TargetType="TextBlock">
                                            <Style.Setters>
                                                <Setter Property="Height" Value="16" />
                                                <Setter Property="TextWrapping" Value="NoWrap" />
                                            </Style.Setters>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWarp}" Value="true">
                                                    <Setter Property="Height" Value="32" />
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <Border Grid.Column="1">
            <ItemsControl Margin="5,2,0,0" ItemsSource="{Binding RunLogMessages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="5" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="RunLogMessageText"
                                     Height="Auto"
                                     BorderBrush="{x:Null}"
                                     BorderThickness="0"
                                     Foreground="{Binding Color}"
                                     GotFocus="RunLogMessageText_OnGotFocus"
                                     IsReadOnly="True"
                                     PreviewMouseDown="RunLogMessageText_OnPreviewMouseDown"
                                     Text="{Binding ContentSubString, Mode=OneWay}"
                                     TextWrapping="Wrap" />
                            <Line Grid.Row="1"
                                  Stretch="Fill"
                                  Stroke="Black"
                                  X2="1" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
