<UserControl x:Class="SheepQQBot3.View.MainWindowAlarmAide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SheepQQBot3.View"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="MainWindowAlarmAideWindow"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="MainWindowAlarmAide_OnLoaded"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <local:MainWindowAlarmAideViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.Resources>
            <Style x:Key="AlarmAideTextBlockStyle"
                   TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="150" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  ItemsSource="{Binding SetConfigs}"  -->
        <ListView x:Name="AlarmAideList"
                  ItemsSource="{Binding SelectedSetConfig.AlarmAideConfigs.Values}"
                  MouseDoubleClick="AlarmAideList_MouseDoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectedItem="{Binding SelectedAlarmAideConfig}">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="AlarmAideList_OnGetGuid"
                              Header="取得Guid" />
                    <MenuItem Click="AlarmAideList_OnAdd"
                              Header="新增" />
                    <MenuItem Click="AlarmAideList_OnEdit"
                              Header="修改"
                              Style="{StaticResource EditDeleteMenuItemStyle}" />
                    <MenuItem Click="AlarmAideList_OnDelete"
                              Header="删除"
                              Style="{StaticResource EditDeleteMenuItemStyle}" />
                    <MenuItem Click="AlarmAideList_OnTest"
                              Header="测试发送"
                              Style="{StaticResource EditDeleteMenuItemStyle}" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource NoResizeHeaderStyle}">
                    <GridViewColumn Width="137"
                                    Header="名称">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource AlarmAideTextBlockStyle}"
                                           Text="{Binding AlarmName}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="442"
                                    Header="时间条件">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource AlarmAideTextBlockStyle}"
                                           Text="{Binding Condition}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Condition}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="30"
                                    CellTemplate="{StaticResource CheckImageButtonTemplate}"
                                    Header="√" />
                    <GridViewColumn Width="30"
                                    Header="投">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton Width="30"
                                              HorizontalAlignment="Center"
                                              Click="List_OnEnable"
                                              IsChecked="{Binding IsDefault}"
                                              IsTabStop="False"
                                              Tag="{Binding}">
                                    <ToggleButton.Template>
                                        <ControlTemplate>
                                            <Image Height="16"
                                                   HorizontalAlignment="Center">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Source" Value="/Resource/close.png" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDefault,
                                                                                           Mode=OneWay}"
                                                                         Value="true">
                                                                <Setter Property="Source" Value="/Resource/check.png" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <Grid Grid.Row="1">
            <GroupBox>
                <GroupBox.Header>
                    <TextBlock Text="提醒内容列表" />
                </GroupBox.Header>
                <ListBox x:Name="AlarmAideTextList"
                         ContextMenuOpening="AlarmAideTextList_OnContextMenuOpening"
                         ItemsSource="{Binding SelectedAlarmAideConfig.AlarmTexts}"
                         MouseDoubleClick="AlarmAideTextList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedItem="{Binding SelectedAlarmText}"
                         SelectionChanged="AlarmAideTextList_OnSelectionChanged"
                         SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Value,
                                                      Converter={StaticResource SingleLineTextConverter}}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       ToolTip="{Binding Value}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Click="AlarmAideTextList_OnAdd"
                                      Header="新增" />
                            <MenuItem Click="AlarmAideTextList_OnCopy"
                                      Header="复制" />
                            <MenuItem Click="AlarmAideTextList_OnEdit"
                                      Header="修改">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSingleSelectedAlarmAideText}"
                                                         Value="true">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <MenuItem Click="AlarmAideTextList_OnDelete"
                                      Header="删除"
                                      Style="{StaticResource EditDeleteMenuItemStyle}" />
                            <MenuItem Click="AlarmAideTextList_OnTest"
                                      Header="测试发送">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSingleSelectedAlarmAideText}"
                                                         Value="true">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <MenuItem Click="AlarmAideTextList_OnExport"
                                      Header="导出" />
                            <MenuItem Click="AlarmAideTextList_OnImport"
                                      Header="导入" />
                            <MenuItem Click="AlarmAideTextList_OnSort"
                                      Header="按内容排序" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
