<UserControl x:Class="SheepQQBot3.View.MainWindowGenshinHelper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SheepQQBot3.View"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="296"
             d:DesignWidth="346"
             Loaded="MainWindowGenshinHelper_OnLoaded"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <local:MainWindowGenshinHelperViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.Resources>
            <Style x:Key="ListViewTextBlockStyle"
                   TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GroupBox Width="296"
                  Height="346">
            <GroupBox.Header>
                <TextBlock Text="原神提醒列表" />
            </GroupBox.Header>
            <ListView x:Name="GenshinResinAlarmList"
                      ItemsSource="{Binding Path=SelectedSetConfig.GenshinHelperConfig.GenshinResinAlarms.Values}"
                      MouseDoubleClick="ListView_MouseDoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectedItem="{Binding SelectedGenshinResinAlarm}">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="ListView_OnAdd"
                                  Header="新增" />
                        <MenuItem Click="ListView_OnEdit"
                                  Header="修改"
                                  Style="{StaticResource EditDeleteMenuItemStyle}" />
                        <MenuItem Click="ListView_OnDelete"
                                  Header="删除"
                                  Style="{StaticResource EditDeleteMenuItemStyle}" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource NoResizeHeaderStyle}">
                        <GridViewColumn Width="80"
                                        Header="名称">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource ListViewTextBlockStyle}"
                                               Text="{Binding Path=ConfigName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="36"
                                        Header="树脂">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton Width="30"
                                                  HorizontalAlignment="Center"
                                                  Click="List_OnEnable"
                                                  IsChecked="{Binding Resin}"
                                                  IsTabStop="False"
                                                  Tag="{Binding}">
                                        <ToggleButton.Template>
                                            <ControlTemplate>
                                                <Image Height="16"
                                                       HorizontalAlignment="Center">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Source" Value="/Resource/close.png" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Resin,
                                                                                               Mode=OneWay}"
                                                                             Value="true">
                                                                    <Setter Property="Source" Value="/Resource/check.png" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="36"
                                        Header="每日">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton Width="30"
                                                  HorizontalAlignment="Center"
                                                  Click="List_OnEnable"
                                                  IsChecked="{Binding DailyMission}"
                                                  IsTabStop="False"
                                                  Tag="{Binding}">
                                        <ToggleButton.Template>
                                            <ControlTemplate>
                                                <Image Height="16"
                                                       HorizontalAlignment="Center">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Source" Value="/Resource/close.png" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DailyMission,
                                                                                               Mode=OneWay}"
                                                                             Value="true">
                                                                    <Setter Property="Source" Value="/Resource/check.png" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="36"
                                        Header="宝钱">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton Width="30"
                                                  HorizontalAlignment="Center"
                                                  Click="List_OnEnable"
                                                  IsChecked="{Binding PotCoin}"
                                                  IsTabStop="False"
                                                  Tag="{Binding}">
                                        <ToggleButton.Template>
                                            <ControlTemplate>
                                                <Image Height="16"
                                                       HorizontalAlignment="Center">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Source" Value="/Resource/close.png" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PotCoin,
                                                                                               Mode=OneWay}"
                                                                             Value="true">
                                                                    <Setter Property="Source" Value="/Resource/check.png" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="36"
                                        Header="质变">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton Width="30"
                                                  HorizontalAlignment="Center"
                                                  Click="List_OnEnable"
                                                  IsChecked="{Binding Transformer}"
                                                  IsTabStop="False"
                                                  Tag="{Binding}">
                                        <ToggleButton.Template>
                                            <ControlTemplate>
                                                <Image Height="16"
                                                       HorizontalAlignment="Center">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Source" Value="/Resource/close.png" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Transformer,
                                                                                               Mode=OneWay}"
                                                                             Value="true">
                                                                    <Setter Property="Source" Value="/Resource/check.png" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="30"
                                        CellTemplate="{StaticResource CheckImageButtonTemplate}"
                                        Header="√" />
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
    </Grid>
</UserControl>
