<UserControl x:Class="SheepQQBot3.View.MainWindowFunctionTest"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SheepQQBot3.View"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <GroupBox Header="发送群消息测试">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border VerticalAlignment="Center">
                        <TextBlock Text="群号" />
                    </Border>
                    <TextBox x:Name="TxtTestSendGroupMessage_GroupId"
                             Grid.Row="0"
                             Grid.Column="1"
                             Text="15873217" />
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                        <TextBlock Text="内容" />
                    </Border>
                    <TextBox x:Name="TxtTestSendGroupMessage_Content"
                             Grid.Row="1"
                             Grid.Column="1"
                             Height="36"
                             HorizontalContentAlignment="Left"
                             VerticalContentAlignment="Top"
                             AcceptsReturn="True"
                             Text="测试群消息"
                             TextWrapping="Wrap" />
                    <Border Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Center">
                        <Button Width="80"
                                Margin="0,5,0,2"
                                Click="TestSendGroupMessage"
                                Content="测试发送" />
                    </Border>
                </Grid>
            </GroupBox>
            <GroupBox Header="发送个人消息测试">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border VerticalAlignment="Center">
                        <TextBlock Text="群号" />
                    </Border>
                    <TextBox x:Name="TxtTestSendPrivateMessage_TargetId"
                             Grid.Row="0"
                             Grid.Column="1"
                             Text="252961222" />
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                        <TextBlock Text="内容" />
                    </Border>
                    <TextBox x:Name="TxtTestSendPrivateMessage_Content"
                             Grid.Row="1"
                             Grid.Column="1"
                             Height="36"
                             HorizontalContentAlignment="Left"
                             VerticalContentAlignment="Top"
                             AcceptsReturn="True"
                             Text="测试个人消息"
                             TextWrapping="Wrap" />
                    <Border Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Center">
                        <Button Width="80"
                                Margin="0,5,0,2"
                                Click="TestSendPrivateMessage"
                                Content="测试发送" />
                    </Border>
                </Grid>
            </GroupBox>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <GroupBox Header="发送Json消息测试">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border VerticalAlignment="Center">
                        <TextBlock Text="群号" />
                    </Border>
                    <TextBox x:Name="TxtTestSendJsonMessage_GroupId"
                             Grid.Row="0"
                             Grid.Column="1"
                             Text="15873217" />
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                        <TextBlock Text="内容" />
                    </Border>
                    <TextBox x:Name="TxtTestSendJsonMessage_Content"
                             Grid.Row="1"
                             Grid.Column="1"
                             Height="100"
                             HorizontalContentAlignment="Left"
                             VerticalContentAlignment="Top"
                             AcceptsReturn="True"
                             Text=""
                             TextWrapping="Wrap" />
                    <Border Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Center">
                        <Button Width="80"
                                Margin="0,5,0,2"
                                Click="TestSendJsonMessage"
                                Content="测试发送" />
                    </Border>
                </Grid>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
