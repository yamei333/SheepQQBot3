<UserControl
    x:Class="SheepQQBot3.View.MainWindowBlackList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SheepQQBot3.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="MainWindowBlackList_OnLoaded"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <local:MainWindowBlackListViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="CheckOppositeImageButtonStyle" TargetType="ToggleButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Image Height="16" HorizontalAlignment="Center">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="/Resource/check.png" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                <Setter Property="Source" Value="/Resource/close.png" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ListViewTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="300" />
        </Grid.RowDefinitions>
        <GroupBox>
            <GroupBox.Header>
                <TextBlock Text="黑名单列表" />
            </GroupBox.Header>
            <ListView
                x:Name="BlackListConfigList"
                ItemsSource="{Binding SelectedSetConfig.BlackListUserConfigs.Values}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedBlackListUserConfig}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="ListView_OnAdd" Header="新增" />
                        <MenuItem
                            Click="ListView_OnDelete"
                            Header="删除"
                            Style="{StaticResource EditDeleteMenuItemStyle}" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource NoResizeHeaderStyle}">
                        <GridViewColumn Width="96" Header="QQ号">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource ListViewTextBlockStyle}" Text="{Binding TargetId}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="32" Header="色图">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton
                                        Click="List_OnEnable"
                                        IsChecked="{Binding BanedSetu}"
                                        Style="{StaticResource CheckOppositeImageButtonStyle}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="48" Header="AI收集">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton
                                        Click="List_OnEnable"
                                        IsChecked="{Binding BanedAICollect}"
                                        Style="{StaticResource CheckOppositeImageButtonStyle}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="32" Header="AIAt">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton
                                        Click="List_OnEnable"
                                        IsChecked="{Binding BanedAIResponse}"
                                        Style="{StaticResource CheckOppositeImageButtonStyle}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="64" Header="群聊收集">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton
                                        Click="List_OnEnable"
                                        IsChecked="{Binding BanedChatSummaryCollect}"
                                        Style="{StaticResource CheckOppositeImageButtonStyle}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="48" Header="AI总结">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton
                                        Click="List_OnEnable"
                                        IsChecked="{Binding BanedChatSummary}"
                                        Style="{StaticResource CheckOppositeImageButtonStyle}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
    </Grid>
</UserControl>
