<Window x:Class="SheepQQBot3.View.GocqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SheepQQBot3.View"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wfc="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        Title="go-cqhttp"
        Width="1080"
        Height="700"
        Closing="GocqWindow_OnClosing"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="微软雅黑" />
            <Setter Property="ResizeMode" Value="CanMinimize" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>
    </Window.Style>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ButtonArea"
                               Height="24" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Width="150"
                        Margin="2,2,0,2"
                        Click="OnRestartGocq"
                        Content="重新启动 go-cqhttp" />
            </StackPanel>
            <Border Grid.Row="1">
                <WindowsFormsHost x:Name="GocqEmbedWindow"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="Black">
                    <wfc:FlowLayoutPanel />
                </WindowsFormsHost>
            </Border>
        </Grid>
    </Grid>
</Window>
