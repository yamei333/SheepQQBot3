<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <appSettings>
        <add key="selfId" value="botQQId"/>
        <add key="adminId" value="adminQQId"/>
        <add key="bark" value=""/>
        <add key="barkexe" value="bark-server_windows_amd64.exe"/>
        <add key="barkkey" value=""/>
        <add key="barkurl" value=""/>
        <add key="serverAddress" value="127.0.0.1"/>
        <add key="serverPort" value="6700"/>
        <add key="saucenaokey" value="saucenaokey"/>
        <add key="clientAddress" value="127.0.0.1"/>
        <add key="clientPort" value="3000"/>
        <add key="clientToken" value="clientToken"/>
        <add key="pixivReverseProxy" value="i.pixiv.cat"/>
        <add key="maxAIHistoryCount" value="200"/>
        <add key="groupChatAtPrompt" value="[{user}]at了你, 回复他一下（随机1~3句话）"/>
