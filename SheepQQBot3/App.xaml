<Application x:Class="SheepQQBot3.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SheepQQBot3"
             Startup="App_OnStartup"
             DispatcherUnhandledException="App_OnDispatcherUnhandledException"
             StartupUri="View/MainWindow/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="View/Style/CommonStyles.xaml" />
                <ResourceDictionary Source="View/Style/DialogWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="CheckImageButtonTemplate">
                <ToggleButton Width="30"
                              HorizontalAlignment="Center"
                              Click="List_OnEnable"
                              IsChecked="{Binding IsActive}"
                              IsTabStop="False"
                              Tag="{Binding}">
                    <ToggleButton.Template>
                        <ControlTemplate>
                            <Image Height="16"
                                   HorizontalAlignment="Center">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="/Resource/close.png" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive,
                                                                           Mode=OneWay}"
                                                         Value="true">
                                                <Setter Property="Source" Value="/Resource/check.png" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </DataTemplate>
            <DataTemplate x:Key="CheckImageButtonTemplate_Value">
                <ToggleButton Width="30"
                              HorizontalAlignment="Center"
                              Click="List_OnEnable"
                              IsChecked="{Binding Value.IsActive}"
                              IsTabStop="False"
                              Tag="{Binding}">
                    <ToggleButton.Template>
                        <ControlTemplate>
                            <Image Height="16"
                                   HorizontalAlignment="Center">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="/Resource/close.png" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Value.IsActive,
                                                                           Mode=OneWay}"
                                                         Value="true">
                                                <Setter Property="Source" Value="/Resource/check.png" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
